# Required — OpenAI key (gpt-image-2 for images, gpt-4o for describe)
OPENAI_API_KEY=

# Optional — if set, /catalog /transparent /describe need header  x-api-key: <this value>
AI_FEATURES_API_KEY=

# Optional — Bearer key for /embed/* (visual search). Same key Jewel Factory already
# sends as EMBEDDER_API_KEY. Falls back to AI_FEATURES_API_KEY if unset.
EMBEDDER_API_KEY=

# Optional — CORS allow-list (CSV). Default: *
AI_FEATURES_ALLOWED_ORIGINS=

# Optional — override models
CATALOG_MODEL=gpt-image-2
TRANSPARENT_MODEL=gpt-image-2
DESCRIBE_MODEL=gpt-4o
